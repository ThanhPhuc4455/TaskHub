APP_ENV=development
# production requires SECRET_KEY with at least 32 non-default characters
LOG_LEVEL=INFO
APP_PORT=8001
POSTGRES_PORT=5435
REDIS_PORT=6380

POSTGRES_DB=taskhub
POSTGRES_USER=taskhub
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql+asyncpg://taskhub:replace-with-a-local-password@db:5432/taskhub

DB_ECHO=false

SECRET_KEY=replace-with-a-local-secret

REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=120
REDIS_SOCKET_CONNECT_TIMEOUT=1.0
REDIS_SOCKET_TIMEOUT=1.0
