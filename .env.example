APP_ENV=development
# production requires SECRET_KEY with at least 32 non-default characters
LOG_LEVEL=INFO
APP_PORT=8001

POSTGRES_DB=taskhub
POSTGRES_USER=taskhub
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql+asyncpg://taskhub:replace-with-a-local-password@127.0.0.1:5432/taskhub

DB_ECHO=false

SECRET_KEY=replace-with-a-local-secret-32-chars

REDIS_URL=redis://127.0.0.1:6379/0
CACHE_TTL_SECONDS=120
REDIS_SOCKET_CONNECT_TIMEOUT=1.0
REDIS_SOCKET_TIMEOUT=1.0

# SMTP is disabled by default. These local values are safe examples only.
SMTP_ENABLED=false
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_START_TLS=false
SMTP_TIMEOUT_SECONDS=10
SMTP_FROM_ADDRESS=taskhub@example.local
MAILPIT_WEB_PORT=8025
